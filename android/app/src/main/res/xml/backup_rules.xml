<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9–11 (minSdk 28). Ugyanaz a két kért másolat: a felhőbe csak végponttól
     végpontig titkosítva, telefonról telefonra csak közvetlen átvitelnél. -->
<full-backup-content>
    <include domain="file" path="backup/cloud/" requireFlags="clientSideEncryption" />
    <include domain="file" path="backup/transfer/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
