<!-- Android 9–11: the opt-in copies only; cloud only end-to-end encrypted. -->
<full-backup-content>
    <include domain="file" path="backup/cloud/" requireFlags="clientSideEncryption" />
    <include domain="file" path="backup/transfer/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
