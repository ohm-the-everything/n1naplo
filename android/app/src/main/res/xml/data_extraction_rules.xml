<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in copies only (src/lib/store.ts). A section without an include would mean
     everything; scripts/ethics-check.mjs guards this. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="backup/cloud/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/transfer/" />
    </device-transfer>
</data-extraction-rules>
