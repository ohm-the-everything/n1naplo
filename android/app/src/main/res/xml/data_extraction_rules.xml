<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. A napló maga sosem kerül mentésbe: csak az a másolat, amit a felhasználó
     kifejezetten kért (src/lib/store.ts). A felhős mentés csak titkosítva fut (képernyőzár
     nélkül sehogy); az átköltözés csak a saját mappáját viszi. Az include nélküli szekció
     "mindent" jelentene — a scripts/ethics-check.mjs ezt is figyeli. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="backup/cloud/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/transfer/" />
    </device-transfer>
</data-extraction-rules>
